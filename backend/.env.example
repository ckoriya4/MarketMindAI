# .env example for MarketMindAI
# Rename this file to .env and fill in your actual Zerodha Kite credentials.
# ------------------------------------------------------------
# Kite API credentials (obtain from https://developers.kite.trade)
KITE_API_KEY=YOUR_KITE_API_KEY_HERE
KITE_API_SECRET=YOUR_KITE_API_SECRET_HERE
# The access token is generated after the first login flow.
# It will be automatically written by the script, but you can put a placeholder.
KITE_ACCESS_TOKEN=YOUR_INITIAL_ACCESS_TOKEN_IF_AVAILABLE

