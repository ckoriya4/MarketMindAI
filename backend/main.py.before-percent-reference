@app.get("/api/options/chain")
def option_chain(
    symbol: str = Query("NIFTY"),
    expiry: Optional[str] = Query(None),
    num_strikes: int = Query(25, ge=3, le=50),
    spot: Optional[float] = Query(None),
):
    current_spot = spot if spot is not None else market_state.get(symbol.upper(), 22859.14)
    return get_dynamic_option_chain(
        symbol=symbol, expiry=expiry, num_strikes=num_strikes, custom_spot=current_spot
    )


@app.post("/api/market/spot")
def update_spot(payload: SpotUpdate):
    symbol = payload.symbol.upper()
    market_state[symbol] = payload.spot
    return {"message": f"Updated {symbol} spot to {payload.spot}", "new_spot": payload.spot}


