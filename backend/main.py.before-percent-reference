def constituents():
    global _members, _members_at
    if _members and time.monotonic() - _members_at < 21600:
        return _members
    path = BASE / 'nifty50.csv'
    try:
        if path.exists():
            content = path.read_text(encoding='utf-8-sig')
        else:
            r = requests.get(
                'https://www.niftyindices.com/IndexConstituent/ind_nifty50list.csv',
                headers={'User-Agent': 'Mozilla/5.0'}, timeout=12)
            r.raise_for_status()
            content = r.content.decode('utf-8-sig')
        members = [{'symbol': row['Symbol'].strip(),
                    'sector': row.get('Industry', '').strip()}
                   for row in csv.DictReader(io.StringIO(content))]
        if len(members) != 50 or len({m['symbol'] for m in members}) != 50:
            raise ValueError('Expected 50 unique symbols')
        _members, _members_at = members, time.monotonic()
        return _members
    except Exception:
        raise HTTPException(503, 'Cannot load NIFTY 50 constituents. Download the official constituent CSV as backend/nifty50.csv.') from None


